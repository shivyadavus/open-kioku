{
  "name": "open-kioku",
  "displayName": "Open Kioku — Code Intelligence",
  "description": "Local-first code intelligence for AI agents. Gives Claude an evidence-backed repository index via BM25 search, Tree-sitter symbol navigation, impact analysis, architecture detection, and patch planning. No hosted index or embeddings API required.",
  "version": "3.0.2",
  "author": {
    "name": "Shiv Yadav",
    "email": "shivyadavus@users.noreply.github.com"
  },
  "homepage": "https://github.com/shivyadavus/open-kioku",
  "repository": "https://github.com/shivyadavus/open-kioku",
  "license": "Elastic-2.0",
  "keywords": ["code-intelligence", "mcp", "search", "symbols", "rust", "local-first", "tree-sitter", "bm25"],
  "category": "developer-tools",
  "mcpServers": {
    "open-kioku": {
      "command": "ok",
      "args": [
        "mcp",
        "serve",
        "--repo",
        "${workspaceFolder}",
        "--read-only"
      ]
    }
  }
}
