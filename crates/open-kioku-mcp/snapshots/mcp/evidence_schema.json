    "examples": [
      {
        "description": "Functions and the files that define them.",
        "query": "MATCH (f:File)-[:DEFINES]->(s:Function) RETURN f, s LIMIT 10"
      },
      {
        "description": "Functions defined in files under src/; file_path compares against the File node label, which is its path.",
        "query": "MATCH (f:File)-[:DEFINES]->(s:Function) WHERE f.file_path STARTS_WITH 'src/' RETURN s"
      },
      {
        "description": "Direct callers of parse_config in src/config.rs, named by its full qualified label.",
        "query": "MATCH (caller:Function)-[:CALLS]->(callee:Function) WHERE callee.label = 'src::config::parse_config' RETURN caller"
      },
      {
        "description": "The DEFINES edge read in reverse: functions whose own name starts with handle_, and the files that define them. A regex filter is not anchored by the index, so this scans every DEFINES edge in memory and can reach the query timeout on a large index.",
        "query": "MATCH (s:Function)<-[:DEFINES]-(f:File) WHERE s.label =~ '::handle_[^:]*$' RETURN s, f"
      },
      {
        "description": "Functions reachable within one to three CALLS hops from functions named run. A multi-hop query walks forward from every Function node before its filters apply, so on a large index it can reach the query timeout; a one-hop query with label = is anchored by the index and much cheaper.",
        "query": "MATCH (a:Function)-[:CALLS *1..3]->(b:Function) WHERE a.label =~ '::run$' RETURN b LIMIT 20"
      },
      {
        "description": "Files whose imports resolve to src/config.rs.",
        "query": "MATCH (f:File)-[:IMPORTS]->(g:File) WHERE g.file_path = 'src/config.rs' RETURN f"
      }
    ],
