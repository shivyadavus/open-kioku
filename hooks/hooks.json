{
  "description": "Open Kioku gate: judge the agent's edits against a declared boundary and write a verified Change Dossier. By default (`[gate] auto = true`) each prompt plans a boundary in the background, a repository with no index is indexed in the background the first time, and a session started this way is advisory: it reports and records, denies only secret-like and generated paths, and never holds the agent. `ok gate start`, or `mode = \"enforce\"` in ok.toml, makes the boundary binding. Every command is `ok` on PATH, the same assumption the plugin's MCP server makes.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ok gate hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ok gate hook prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ok gate hook pre-tool",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ok gate hook post-tool",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ok gate hook stop",
            "timeout": 600
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ok gate hook session-end",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
